rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Utility functions ──────────────────────────────────────────────────
    function isAuthenticated() { return request.auth != null; }

    function isEmailVerified() {
      return request.auth.token.email_verified == true
          || request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isActive() { return request.auth.token.isActive == true; }

    function isSuperAdmin() { return request.auth.token.role == 'superadmin'; }

    function isOwner() {
      return request.auth.token.role == 'owner' || isSuperAdmin();
    }

    function isAdmin() {
      return request.auth.token.role == 'admin'
          || isOwner();
    }

    function isUser() {
      return request.auth.token.role == 'user'
          || request.auth.token.role == 'member'
          || request.auth.token.role == 'operator'  // legacy
          || request.auth.token.role == 'manager'   // legacy
          || request.auth.token.role == 'viewer';   // legacy
    }

    function belongsToTenant(tenantId) {
      return request.auth.token.tenantId == tenantId
          || isSuperAdmin()
          || tenantId == 'default-tenant'
          || tenantId == request.auth.uid
          || !('tenantId' in request.auth.token);
    }

    function isActiveAndVerified() {
      return isAuthenticated() && isEmailVerified() && isActive();
    }

    // ── Deny all by default ────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Tenant-isolated collections ────────────────────────────────────────
    match /tenants/{tenantId} {
      // Tenant root doc: only admin/owner can write; any member can read
      // Direct deletion blocked client-side: MUST go through deleteTenantAndAccount Cloud Function
      allow read: if isActiveAndVerified() && belongsToTenant(tenantId);
      allow create: if isActiveAndVerified() && isOwner();
      allow update: if isActiveAndVerified() && isOwner();
      allow delete: if false;
    }

    match /tenants/{tenantId}/workspaces/{workspaceId} {
      // Workspace metadata: admin can create/update/delete; users can read
      allow read: if isActiveAndVerified() && belongsToTenant(tenantId);
      allow create, update: if isActiveAndVerified() && isAdmin() && belongsToTenant(tenantId);
      allow delete: if isActiveAndVerified() && isAdmin() && belongsToTenant(tenantId);
    }

    match /tenants/{tenantId}/workspaces/{workspaceId}/tasks/{taskId} {
      // Tasks: all members read/create; admin can delete; immutable fields protected
      allow read: if isActiveAndVerified() && belongsToTenant(tenantId);
      allow create: if isActiveAndVerified() && belongsToTenant(tenantId)
        && (isAdmin() || isUser());
      allow update: if isActiveAndVerified() && belongsToTenant(tenantId)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['createdAt', 'createdBy', 'tenantId']);
      allow delete: if isActiveAndVerified() && isAdmin() && belongsToTenant(tenantId);
    }

    match /tenants/{tenantId}/workspaces/{workspaceId}/tasks/{taskId}/{document=**} {
      // Task sub-collections (messages, subtasks, approvals): same as task
      allow read: if isActiveAndVerified() && belongsToTenant(tenantId);
      allow create, update: if isActiveAndVerified() && belongsToTenant(tenantId)
        && (isAdmin() || isUser());
      allow delete: if isActiveAndVerified() && isAdmin() && belongsToTenant(tenantId);
    }

    match /tenants/{tenantId}/knowledgeBase/{kbId} {
      // Knowledge base: all tenant members read; admin can write
      allow read: if isActiveAndVerified() && belongsToTenant(tenantId);
      allow write: if isActiveAndVerified() && isAdmin() && belongsToTenant(tenantId);
    }

    match /tenants/{tenantId}/members/{memberId} {
      // Members list: readable by tenant members; admin manages
      allow read: if isActiveAndVerified() && belongsToTenant(tenantId);
      allow write: if isActiveAndVerified() && isAdmin() && belongsToTenant(tenantId);
    }

    match /tenants/{tenantId}/invitations/{tokenHash} {
      // ── Invitations (Step 14 — Email Magic Invitation) ──────────────────
      // READ: Admin can list/view pending invitations for their tenant dashboard.
      allow read: if isActiveAndVerified() && isAdmin() && belongsToTenant(tenantId);

      // CREATE: Admin can issue new invitations. invitedBy must match the caller UID.
      allow create: if isActiveAndVerified() && isAdmin() && belongsToTenant(tenantId)
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.tenantId == tenantId;

      // UPDATE: Admin can revoke (set status = 'revoked') — no other field changes.
      allow update: if isActiveAndVerified() && isAdmin() && belongsToTenant(tenantId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'revoked';

      // DELETE: Admin can delete an invitation document (purge).
      allow delete: if isActiveAndVerified() && isAdmin() && belongsToTenant(tenantId);

      // ⛔ ACCEPTANCE IS BLOCKED CLIENT-SIDE — must go through Cloud Function (Admin SDK).
      // The Cloud Function uses runTransaction + setCustomUserClaims — not writable by client.
    }

    // ── User profiles (Privacy First) ─────────────────────────────────────
    match /users_metadata/{userId}/{document=**} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      allow read: if isAuthenticated() && isAdmin(); // admin can list members
    }

    // ── Audit logs (GDPR Art. 30 — Append Only) ───────────────────────────
    match /audit/{logId} {
      allow read: if isActiveAndVerified() && isAdmin();
      allow create: if isActiveAndVerified()
        && request.resource.data.tenantId == request.auth.token.tenantId
        && request.resource.data.timestamp == request.time;
      allow update, delete: if false; // Non-ripudio: audit logs IMMUTABLE
    }

    // ── Global reference data (Read-only for authenticated users) ─────────
    match /reference/{document=**} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}